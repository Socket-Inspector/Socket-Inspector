{
  "name": "socket-inspector",
  "displayName": "Socket Inspector",
  "private": true,
  "version": "1.0.12",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "dev:mock": "CUSTOM_OUT_DIR=.mock_output VITE_MOCK_TAB_ID=1234 wxt",
    "build:mock": "CUSTOM_OUT_DIR=.mock_output VITE_MOCK_TAB_ID=1234 wxt build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "prepare": "wxt prepare",
    "test:unit": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@mswjs/interceptors": "0.41.3",
    "@socket-inspector/shadcn": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "3.13.12",
    "lucide-react": "catalog:",
    "monaco-editor": "^0.52.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wxt": "^0.20.27"
  }
}
