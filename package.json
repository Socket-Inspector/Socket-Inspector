{
  "name": "socket-inspector-workspace",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extension:lint": "pnpm --filter socket-inspector lint",
    "extension:lint:fix": "pnpm --filter socket-inspector lint:fix",
    "test-app:serve": "pnpm --parallel --filter test-app-server --filter test-app-ui serve",
    "playwright:prepare": "pnpm --filter socket-inspector build:mock & pnpm run test-app",
    "playwright:test": "pnpm --filter playwright-tests test",
    "playwright:ui": "pnpm --filter playwright-tests test:ui",
    "release": "bash ./build-scripts/release-pipeline.sh"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
