{
  "name": "socket-inspector-workspace",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter socket-inspector dev",
    "build": "pnpm --filter socket-inspector build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter socket-inspector lint",
    "lint:fix": "pnpm --filter socket-inspector lint:fix",
    "typecheck": "pnpm --filter socket-inspector prepare && pnpm --filter socket-inspector compile",
    "test:unit": "pnpm --filter socket-inspector test:unit",
    "prepare:e2e": "pnpm --filter socket-inspector build:mock",
    "e2e": "pnpm --filter playwright-tests test",
    "e2e:ui": "pnpm --filter playwright-tests test:ui",
    "shell-lint": "pnpm shellcheck build-scripts/*.sh",
    "serve:test-app": "pnpm --parallel --filter test-app-server --filter test-app-ui serve",
    "prepare:release": "bash ./build-scripts/release-pipeline.sh"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shellcheck": "^4.1.0"
  }
}
