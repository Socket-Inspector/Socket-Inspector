{
  "name": "socket-inspector-workspace",
  "private": true,
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter socket-inspector dev",
    "build": "pnpm --filter socket-inspector build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter socket-inspector --filter playwright-tests-v2 lint",
    "lint:fix": "pnpm --filter socket-inspector --filter playwright-tests-v2 lint:fix",
    "typecheck": "pnpm --filter socket-inspector prepare && pnpm --filter socket-inspector compile && pnpm --filter playwright-tests-v2 typecheck",
    "test:unit": "pnpm --filter socket-inspector test:unit",
    "prepare:e2e": "pnpm --filter socket-inspector build:mock",
    "e2e": "pnpm --filter playwright-tests test",
    "e2e:ui": "pnpm --filter playwright-tests test:ui",
    "e2e:v2": "pnpm --filter playwright-tests-v2 test",
    "e2e:v2:ui": "pnpm --filter playwright-tests-v2 test:ui",
    "serve:test-app": "pnpm --parallel --filter test-app-server --filter test-app-ui serve",
    "serve:test-app-tiny": "pnpm --parallel --filter test-app-server --filter test-app-tiny serve:test-app-tiny",
    "prepare:release": "bash ./shell-scripts/release-pipeline.sh"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "dependencies": {
    "engine.io-parser": "^5.2.3",
    "socket.io-parser": "^4.2.7"
  }
}
